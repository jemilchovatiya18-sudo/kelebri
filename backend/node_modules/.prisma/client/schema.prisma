// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiamondType {
  LAB_GROWN
  NATURAL
  MOISSANITE
  NONE
}

enum MetalType {
  GOLD
  WHITE_GOLD
  ROSE_GOLD
  SILVER
  PLATINUM
}

enum GoldPurity {
  K14
  K18
  K22
  K24
  NONE
}

enum Certificate {
  GIA
  IGI
  SGL
  HRD
  NONE
}

enum CategoryType {
  JEWELRY
  DIAMOND
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType @default(JEWELRY)
  imageUrl  String?
  publicId  String?
  sortOrder Int          @default(0)
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Product {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  sku            String  @unique
  description    String? @db.Text
  specifications String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  diamondType    DiamondType @default(NONE)
  metalType      MetalType   @default(GOLD)
  metalColor     String?
  goldPurity     GoldPurity  @default(NONE)
  diamondWeight  String?
  diamondShape   String?
  diamondQuality String?
  diamondColor   String?
  diamondClarity String?
  stoneType      String?
  certificate    Certificate @default(NONE)

  price     Float?
  showPrice Boolean @default(false)

  isAvailable   Boolean @default(true)
  isSoldOut     Boolean @default(false)
  isBestSeller  Boolean @default(false)
  isHeroProduct Boolean @default(false)

  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
